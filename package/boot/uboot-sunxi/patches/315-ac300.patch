diff --git a/arch/arm/mach-sunxi/clock_sun50i_h6.c b/arch/arm/mach-sunxi/clock_sun50i_h6.c
index 4c522f608102..91714dbbd86a 100644
--- a/arch/arm/mach-sunxi/clock_sun50i_h6.c
+++ b/arch/arm/mach-sunxi/clock_sun50i_h6.c
@@ -8,6 +8,7 @@ void clock_init_safe(void)
 {
 	void *const ccm = (void *)SUNXI_CCM_BASE;
 	void *const prcm = (void *)SUNXI_PRCM_BASE;
+	void *const pwm = (void *)SUNXI_PWM_BASE;
 
 	if (IS_ENABLED(CONFIG_MACH_SUN50I_H616)) {
 		/* this seems to enable PLLs on H616 */
@@ -49,6 +50,12 @@ void clock_init_safe(void)
 	 * DRAM initialization code.
 	 */
 	writel(MBUS_CLK_SRC_PLL6X2 | MBUS_CLK_M(3), ccm + CCU_H6_MBUS_CFG);
+
+	/* add for pwm ephy */
+	writel(CCU_PWM_RST | CCU_PWM_GATING, ccm + CCU_H6_PWM_GATE_RESET);
+	writel(PWM_CLK_GATING | PWM_CLK_BYPASS, pwm + PWM_CH5_PPR);
+	writel(PWM45_CLK_GATING | PWM5_CLK_BYPASS, pwm + PWM_PWM45_CLK_CFG);
+	writel(PWM_CH5_ENABLE, pwm + PWM_PER);
 }
 
 void clock_init_uart(void)
@@ -100,6 +107,7 @@ void clock_set_pll1(unsigned int clk)
 	val |= CCM_CPU_AXI_MUX_PLL_CPUX;
 	writel(val, ccm + CCU_H6_CPU_AXI_CFG);
 }
+#endif /* CONFIG_XPL_BUILD */
 
 int clock_twi_onoff(int port, int state)
 {
@@ -126,7 +134,6 @@ int clock_twi_onoff(int port, int state)
 
